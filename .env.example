# Copy to .env (or run: python scripts/bootstrap.py). Never commit the real .env.
CREDENTIAL_KEY=
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@akis.local
POSTGRES_PASSWORD=
# Optional: hosted PostgreSQL. Leave empty for local SQLite (dev) or Compose Postgres.
DATABASE_URL=
# Browser origin used for cookies, CSRF checks and OAuth callbacks.
APP_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=
# Local launcher: cloudflare (named tunnel) or ngrok (fixed development URL).
PUBLIC_TUNNEL_PROVIDER=cloudflare
CLOUDFLARE_TUNNEL=akis-dev
# Optional: Cloudinary media storage. Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
KEEP_LOCAL_MEDIA=true
MAX_UPLOAD_MB=100
# Total source and generated media per company. Set to 0 only if another storage quota is enforced.
COMPANY_STORAGE_MB=500
MEDIA_MAX_DURATION_SECONDS=600
MEDIA_MAX_PIXELS=40000000
# Keep this at 1 on memory-limited hosted services.
FFMPEG_THREADS=1
FFMPEG_TIMEOUT_SECONDS=420
# Default 0: manual backups only. Set a positive day interval to opt in to automatic backups.
BACKUP_INTERVAL_DAYS=0
BACKUP_KEEP=3
# auto: keep verified backups in private Cloudinary storage when CLOUDINARY_URL is configured.
# Set to local to explicitly disable remote backup storage.
BACKUP_REMOTE=auto
BACKUP_DOWNLOAD_MAX_MB=500
# Keep detailed completed delivery attempts for 90 days; 0 disables this cleanup.
DELIVERY_ATTEMPT_RETENTION_DAYS=90
# Optional comma-separated override. Empty uses Tauri webview origins and adds
# http://localhost:1420 only in LOCAL_MODE=true.
APP_CLIENT_ORIGINS=
