# Copy to .env (or run: python scripts/bootstrap.py). Never commit the real .env.
CREDENTIAL_KEY=
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@akis.local
POSTGRES_PASSWORD=
# Optional: hosted PostgreSQL. Leave empty for local SQLite (dev) or Compose Postgres.
DATABASE_URL=
# Browser origin used for cookies, CSRF checks and OAuth callbacks.
APP_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=
# Local launcher: cloudflare (named tunnel) or ngrok (fixed development URL).
PUBLIC_TUNNEL_PROVIDER=cloudflare
CLOUDFLARE_TUNNEL=akis-dev
# Optional: Cloudinary media storage. Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
KEEP_LOCAL_MEDIA=true
MAX_UPLOAD_MB=100
MEDIA_MAX_DURATION_SECONDS=600
MEDIA_MAX_PIXELS=40000000
# Keep this at 1 on memory-limited hosted services.
FFMPEG_THREADS=1
FFMPEG_TIMEOUT_SECONDS=420
BACKUP_KEEP=14
# Remove the localhost origin in production if desktop development is not needed.
APP_CLIENT_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420
